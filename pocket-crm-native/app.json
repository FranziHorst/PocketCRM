{
  "expo": {
    "name": "Pocket CRM Native",
    "slug": "pocket-crm-native",
    "scheme": "pocketcrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pocket-crm-native"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pocket CRM to scan LinkedIn QR codes to add contacts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pocket CRM to use a photo from your library as your profile picture."
        }
      ]
    ]
  }
}
