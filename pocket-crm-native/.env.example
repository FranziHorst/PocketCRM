# The app never holds the Gemini key itself - it calls our own Netlify
# Function (netlify/functions/gemini.mts), which attaches the real key
# server-side. That keeps the key out of the shipped app bundle entirely.
#
# Set this in the Netlify dashboard (Site settings -> Environment variables),
# NOT with the EXPO_PUBLIC_ prefix - that prefix gets inlined into the client
# bundle, which is exactly what we don't want for this one.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Client-side, safe to expose (just a model name and this site's own URL).
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
# Only needed if you deploy the proxy under a different URL than the default
# in src/gemini.ts.
# EXPO_PUBLIC_SITE_ORIGIN=https://pocketcrm-ai-hackathon.netlify.app
