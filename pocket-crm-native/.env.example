# Copy to .env and fill in. .env is gitignored - never commit a real key.
# Key from https://aistudio.google.com/apikey
#
# EXPO_PUBLIC_ vars are inlined into the app bundle, so anyone with the built
# app can read this key. Fine for the demo; for a release, put the calls behind
# a small server (see pocket-crm/server.ts) and point the app at that instead.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
